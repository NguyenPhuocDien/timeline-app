# Timeline Focus Cloud - Environment Variables
# Copy this file to .env.local and fill in the values.
# If the Vercel project is already linked, you can also run:
#   vercel env pull .env.local --yes
# NEVER commit .env.local to git
# Avoid using .env.production.local for everyday local builds.

# App URL
# Your production domain, for example: https://timeline-focus.vercel.app
# Leave empty on Vercel if you want automatic URL detection
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# Find these at: https://supabase.com -> Your project -> Settings -> API

# Project URL (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=<paste-supabase-project-url>

# Anon/public key (safe to expose - restricted by RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<paste-supabase-publishable-key>

# Service role key (KEEP SECRET - bypasses RLS, server-only)
SUPABASE_SERVICE_ROLE_KEY=<paste-supabase-service-role-key>
