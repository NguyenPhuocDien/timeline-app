{
  "name": "timeline-focus-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace coordinator for the two Timeline Focus products",
  "scripts": {
    "dev:legacy": "npm --prefix legacy-pwa run dev",
    "test:legacy": "npm --prefix legacy-pwa run test:e2e",
    "test:legacy:headed": "npm --prefix legacy-pwa run test:e2e:headed",
    "dev:cloud": "npm --prefix cloud-web run dev",
    "build:cloud": "npm --prefix cloud-web run build",
    "start:cloud": "npm --prefix cloud-web run start",
    "lint:cloud": "npm --prefix cloud-web run lint",
    "test:cloud": "npm run lint:cloud && npm run build:cloud",
    "test:cloud:smoke": "npm --prefix cloud-web run test:smoke",
    "test": "npm run test:legacy && npm run test:cloud"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NguyenPhuocDien/timeline-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/NguyenPhuocDien/timeline-app/issues"
  },
  "homepage": "https://github.com/NguyenPhuocDien/timeline-app#readme"
}
