{
  "name": "timeline-app",
  "version": "1.0.0",
  "private": true,
  "description": "Timeline Focus monorepo",
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @timeline/web",
    "dev:web": "npm run dev --workspace @timeline/web",
    "build": "npm run build --workspace @timeline/web",
    "test": "npm run test:e2e --workspace @timeline/web",
    "test:e2e": "npm run test:e2e --workspace @timeline/web",
    "test:e2e:headed": "npm run test:e2e:headed --workspace @timeline/web",
    "turbo": "turbo"
  },
  "devDependencies": {
    "turbo": "^2.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NguyenPhuocDien/timeline-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/NguyenPhuocDien/timeline-app/issues"
  },
  "homepage": "https://github.com/NguyenPhuocDien/timeline-app#readme"
}
