rules_version = '2';

// =============================================================================
// Timeline Focus — Firestore Security Rules (Phase B FIX)
//
// Sửa: focusSessions → sessions, thêm reviews collection
//
// App.js schema:
//   db = { tasks, events, sessions, settings, reviews }
//
// Triết lý:
//   1. Mỗi user CHỈ đọc/ghi data của chính mình
//   2. Validate kiểu cơ bản để chống ghi rác
//   3. Block hoàn toàn truy cập cross-user
//
// Deploy: firebase deploy --only firestore:rules
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ────── HELPERS ──────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isString(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    function isOptionalString(v, maxLen) {
      return v == null || isString(v, maxLen);
    }

    // ────── ROOT USER DOC ────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isOwner(userId);

      // Cho phép migrationVersion, migratedAt, _backup_v1, legacy .db field
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
            'migrationVersion', 'migratedAt', 'lastSeenAt',
            'displayName', 'email',
            'db',              // legacy schema v1 — giữ để rollback
            '_backup_v1', '_v1HadData', '_v1ItemCount',
            '_migrationStartedAt', '_rolledBackAt'
          ]);

      // Không cho hard delete user doc trực tiếp
      allow delete: if false;

      // ─── SETTINGS: 1 document duy nhất ────────────────────────────────────
      match /settings/{settingsId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
          && settingsId == 'main'
          && isValidSettings(request.resource.data);
        allow delete: if false;
      }

      // ─── REVIEWS: 1 document map theo ngày ────────────────────────────────
      match /reviews/{reviewsId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
          && reviewsId == 'main'
          && isValidReviews(request.resource.data);
        allow delete: if false;
      }

      // ─── TASKS ────────────────────────────────────────────────────────────
      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTask(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // ─── EVENTS ───────────────────────────────────────────────────────────
      match /events/{eventId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidEvent(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // ─── SESSIONS (KHÔNG phải focusSessions) ──────────────────────────────
      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSession(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // ─── META ─────────────────────────────────────────────────────────────
      match /meta/{metaId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
          && metaId in ['main', 'devices', 'syncLog']
          && request.resource.data.size() <= 100;
        allow delete: if false;
      }

      // ─── CATCH-ALL trong /users/{userId}/ ─────────────────────────────────
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ────── CHẶN MỌI THỨ KHÁC NGOÀI /users/{userId} ──────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ════════════════════════════════════════════════════════════════════════
    // VALIDATORS
    // ════════════════════════════════════════════════════════════════════════

    function isValidTask(data) {
      return data.keys().hasOnly([
          'id', 'title', 'date', 'duration', 'priority',
          'start', 'end', 'deadline', 'status',
          'tags', 'eventId', 'notes',
          'mission', 'done',
          'stackType', 'stackedAt', 'reason', 'deferCount', 'doneAt',
          'flow',
          'createdAt', 'updatedAt', 'deletedAt',
          'migratedFrom'
        ])
        // Required
        && isString(data.title, 500)
        && isString(data.date, 10)
        && data.status in ['todo', 'doing', 'done', 'deferred', 'stack', 'deleted']
        && data.priority in ['high', 'medium', 'low']
        && (data.duration is int && data.duration >= 0 && data.duration <= 1440)
        // Optional strings
        && isOptionalString(data.get('start', null), 8)
        && isOptionalString(data.get('end', null), 8)
        && isOptionalString(data.get('deadline', null), 8)
        && isOptionalString(data.get('notes', null), 10000)
        && isOptionalString(data.get('eventId', null), 100)
        && isOptionalString(data.get('id', null), 100)
        && isOptionalString(data.get('stackType', null), 50)
        && isOptionalString(data.get('stackedAt', null), 30)
        && isOptionalString(data.get('reason', null), 500)
        && isOptionalString(data.get('doneAt', null), 30)
        && isOptionalString(data.get('createdAt', null), 30)
        && isOptionalString(data.get('updatedAt', null), 30)
        && isOptionalString(data.get('deletedAt', null), 30)
        // Booleans
        && (data.get('mission', false) is bool)
        && (data.get('done', false) is bool)
        // deferCount
        && (data.get('deferCount', 0) is int && data.deferCount >= 0)
        // tags là list
        && (data.tags is list && data.tags.size() <= 50)
        // flow là map
        && (!('flow' in data) || data.flow is map);
    }

    function isValidEvent(data) {
      return data.keys().hasOnly([
          'id', 'title', 'type', 'date', 'recurring', 'notes',
          'createdAt', 'updatedAt', 'deletedAt',
          'migratedFrom'
        ])
        && isString(data.title, 500)
        && isString(data.date, 10)
        && data.type in ['solar', 'lunar']
        // recurring là boolean (app.js dùng true/false)
        && (data.recurring is bool)
        && isOptionalString(data.get('notes', null), 5000)
        && isOptionalString(data.get('id', null), 100)
        && isOptionalString(data.get('createdAt', null), 30)
        && isOptionalString(data.get('updatedAt', null), 30)
        && isOptionalString(data.get('deletedAt', null), 30);
    }

    function isValidSettings(data) {
      return data.keys().hasOnly([
          'theme', 'accent', 'availableStart', 'availableEnd',
          'dailyMissionLimit', 'notifications',
          'backgroundPreset', 'backgroundName', 'backgroundImage',
          'createdAt', 'updatedAt', 'migratedFrom'
        ])
        && isOptionalString(data.get('theme', null), 50)
        && isOptionalString(data.get('accent', null), 50)
        && isOptionalString(data.get('availableStart', null), 8)
        && isOptionalString(data.get('availableEnd', null), 8)
        && (data.get('dailyMissionLimit', 0) is number
            && data.get('dailyMissionLimit', 0) >= 0
            && data.get('dailyMissionLimit', 0) <= 100)
        && (data.get('notifications', false) is bool)
        && isOptionalString(data.get('backgroundPreset', null), 50)
        && isOptionalString(data.get('backgroundName', null), 200)
        // KHÔNG cho phép ghi base64 image (chống vỡ 1MB)
        && (!('backgroundImage' in data)
            || data.backgroundImage == ''
            || data.backgroundImage == null)
        && isOptionalString(data.get('createdAt', null), 30)
        && isOptionalString(data.get('updatedAt', null), 30);
    }

    function isValidReviews(data) {
      // createdAt: commitBatched của sync-engine tự thêm khi thiếu, và doc cũ đã có sẵn
      return data.keys().hasOnly(['data', 'updatedAt', 'createdAt', 'migratedFrom'])
        && (data.get('data', {}) is map)
        && isOptionalString(data.get('updatedAt', null), 30)
        && isOptionalString(data.get('createdAt', null), 30);
    }

    function isValidSession(data) {
      return data.keys().hasOnly([
          'id', 'taskId', 'date', 'minutes',
          'createdAt', 'updatedAt', 'deletedAt',
          'migratedFrom'
        ])
        && isOptionalString(data.get('id', null), 100)
        && isOptionalString(data.get('taskId', null), 100)
        && isOptionalString(data.get('date', null), 10)
        && (data.get('minutes', 0) is int && data.minutes >= 0 && data.minutes <= 1440)
        && isOptionalString(data.get('createdAt', null), 30)
        && isOptionalString(data.get('updatedAt', null), 30)
        && isOptionalString(data.get('deletedAt', null), 30);
    }
  }
}
