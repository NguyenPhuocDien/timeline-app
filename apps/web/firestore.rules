rules_version = '2';

// Timeline Focus Firestore rules.
// Data is private to /users/{uid}; hard deletes are allowed for owner-driven
// account deletion and retention cleanup.

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isOptionalString(value, maxLength) {
      return value == null || isString(value, maxLength);
    }

    function isOptionalDateValue(value) {
      return value == null
        || value is timestamp
        || isString(value, 30);
    }

    function isValidRootUser(data) {
      return data.keys().hasOnly([
          'migrationVersion', 'migratedAt', 'lastSeenAt',
          'displayName', 'email',
          'db',
          '_backup_v1', '_v1HadData', '_v1ItemCount',
          '_migrationStartedAt', '_rolledBackAt'
        ])
        && (!('migrationVersion' in data)
          || (data.migrationVersion is int
            && data.migrationVersion >= 1
            && data.migrationVersion <= 100))
        && isOptionalDateValue(data.get('migratedAt', null))
        && isOptionalDateValue(data.get('lastSeenAt', null))
        && isOptionalString(data.get('displayName', null), 200)
        && isOptionalString(data.get('email', null), 320)
        && (!('db' in data) || data.db is map)
        && (!('_backup_v1' in data) || data._backup_v1 is map)
        && (!('_v1HadData' in data) || data._v1HadData is bool)
        && (!('_v1ItemCount' in data)
          || (data._v1ItemCount is int && data._v1ItemCount >= 0))
        && isOptionalDateValue(data.get('_migrationStartedAt', null))
        && isOptionalDateValue(data.get('_rolledBackAt', null));
    }

    function hasMatchingId(data, documentId) {
      return data.id is string
        && data.id == documentId
        && data.id.size() > 0
        && data.id.size() <= 100;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidRootUser(request.resource.data);
      allow delete: if isOwner(userId);

      match /settings/{settingsId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && settingsId == 'main'
          && isValidSettings(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /reviews/{reviewsId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && reviewsId == 'main'
          && isValidReviews(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasMatchingId(request.resource.data, taskId)
          && isValidTask(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /events/{eventId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasMatchingId(request.resource.data, eventId)
          && isValidEvent(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasMatchingId(request.resource.data, sessionId)
          && isValidSession(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /meta/{metaId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && metaId in ['main', 'devices', 'syncLog']
          && request.resource.data.size() <= 100;
        allow delete: if isOwner(userId);
      }

      // Google Calendar two-way sync (server-written via Admin SDK).
      // gcal_links: app<->Google id mapping — client may READ to reconcile, never write.
      // gcal_tokens / gcal_state hold the encrypted refresh token and sync state;
      // they are intentionally left to the catch-all below (deny all client access).
      match /gcal_links/{appId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function isValidTask(data) {
      return data.keys().hasOnly([
          'id', 'title', 'date', 'duration', 'priority',
          'start', 'end', 'deadline', 'status',
          'tags', 'eventId', 'calendarId', 'notes',
          'projectId', 'goalId', 'impact', 'energy',
          'mission', 'done',
          'stackType', 'stackedAt', 'reason', 'deferCount', 'doneAt',
          'flow',
          'createdAt', 'updatedAt', 'deletedAt',
          'migratedFrom'
        ])
        && isString(data.title, 500)
        && isString(data.date, 10)
        && data.status in ['todo', 'doing', 'done', 'deferred', 'stack', 'deleted']
        && data.priority in ['high', 'medium', 'low']
        && data.duration is int
        && data.duration >= 0
        && data.duration <= 1440
        && isOptionalString(data.get('start', null), 8)
        && isOptionalString(data.get('end', null), 8)
        && isOptionalString(data.get('deadline', null), 10)
        && isOptionalString(data.get('notes', null), 10000)
        && isOptionalString(data.get('eventId', null), 100)
        && isOptionalString(data.get('calendarId', null), 100)
        && isOptionalString(data.get('projectId', null), 100)
        && isOptionalString(data.get('goalId', null), 100)
        && (!('impact' in data) || data.impact in ['high', 'medium', 'low'])
        && (!('energy' in data) || data.energy in ['deep', 'normal', 'light'])
        && isOptionalString(data.get('stackType', null), 50)
        && isOptionalString(data.get('stackedAt', null), 30)
        && isOptionalString(data.get('reason', null), 500)
        && isOptionalString(data.get('doneAt', null), 30)
        && isOptionalString(data.get('createdAt', null), 30)
        && isOptionalString(data.get('updatedAt', null), 30)
        && isOptionalString(data.get('deletedAt', null), 30)
        && data.get('mission', false) is bool
        && data.get('done', false) is bool
        && data.get('deferCount', 0) is int
        && data.get('deferCount', 0) >= 0
        && data.tags is list
        && data.tags.size() <= 50
        && (!('flow' in data) || data.flow is map);
    }

    function isValidEvent(data) {
      return data.keys().hasOnly([
          'id', 'title', 'type', 'date', 'recurring', 'calendarId', 'notes',
          'createdAt', 'updatedAt', 'deletedAt',
          'migratedFrom'
        ])
        && isString(data.title, 500)
        && isString(data.date, 10)
        && data.type in ['solar', 'lunar']
        && data.recurring is bool
        && isOptionalString(data.get('calendarId', null), 100)
        && isOptionalString(data.get('notes', null), 5000)
        && isOptionalString(data.get('createdAt', null), 30)
        && isOptionalString(data.get('updatedAt', null), 30)
        && isOptionalString(data.get('deletedAt', null), 30);
    }

    function isValidSettings(data) {
      return data.keys().hasOnly([
          'theme', 'accent', 'availableStart', 'availableEnd',
          'dailyMissionLimit', 'notifications',
          'backgroundPreset', 'backgroundName', 'backgroundImage',
          'workspace',
          'createdAt', 'updatedAt', 'migratedFrom'
        ])
        && isOptionalString(data.get('theme', null), 50)
        && isOptionalString(data.get('accent', null), 50)
        && isOptionalString(data.get('availableStart', null), 8)
        && isOptionalString(data.get('availableEnd', null), 8)
        && data.get('dailyMissionLimit', 0) is number
        && data.get('dailyMissionLimit', 0) >= 0
        && data.get('dailyMissionLimit', 0) <= 100
        && data.get('notifications', false) is bool
        && isOptionalString(data.get('backgroundPreset', null), 50)
        && isOptionalString(data.get('backgroundName', null), 200)
        && (!('workspace' in data) || data.workspace is map)
        && (!('backgroundImage' in data)
          || data.backgroundImage == ''
          || data.backgroundImage == null)
        && isOptionalString(data.get('createdAt', null), 30)
        && isOptionalString(data.get('updatedAt', null), 30);
    }

    function isValidReviews(data) {
      return data.keys().hasOnly(['data', 'updatedAt', 'createdAt', 'migratedFrom'])
        && data.get('data', {}) is map
        && isOptionalString(data.get('updatedAt', null), 30)
        && isOptionalString(data.get('createdAt', null), 30);
    }

    function isValidSession(data) {
      return data.keys().hasOnly([
          'id', 'taskId', 'date', 'minutes',
          'createdAt', 'updatedAt', 'deletedAt',
          'migratedFrom'
        ])
        && isOptionalString(data.get('taskId', null), 100)
        && isOptionalString(data.get('date', null), 10)
        && data.get('minutes', 0) is int
        && data.get('minutes', 0) >= 0
        && data.get('minutes', 0) <= 1440
        && isOptionalString(data.get('createdAt', null), 30)
        && isOptionalString(data.get('updatedAt', null), 30)
        && isOptionalString(data.get('deletedAt', null), 30);
    }
  }
}
