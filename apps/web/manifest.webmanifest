{
  "name": "Timeline Focus",
  "short_name": "TL Focus",
  "description": "Offline timeline, task, focus & work planner — quản lý thời gian cá nhân.",
  "id": "timeline-focus-v1",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f7f8fa",
  "theme_color": "#2563eb",
  "lang": "vi",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    {
      "name": "Thêm Task",
      "short_name": "Task mới",
      "description": "Tạo task mới nhanh",
      "url": "./index.html?action=new-task",
      "icons": [{ "src": "img/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Hôm nay",
      "short_name": "Hôm nay",
      "description": "Xem dashboard hôm nay",
      "url": "./index.html#dashboard",
      "icons": [{ "src": "img/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
